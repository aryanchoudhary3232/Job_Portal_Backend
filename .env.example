# ==========================================
# AWS RDS PostgreSQL Configuration
# Format: postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public&sslmode=prefer
# Example: postgresql://postgres:MySecurePass123!@jobportal-db.cxxxxxx.us-east-1.rds.amazonaws.com:5432/ncrjobs_auth?schema=public
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncrjobs_auth?schema=public

# ==========================================
# Port Configuration
# ==========================================
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
JOB_SERVICE_PORT=4003
APPLICATION_SERVICE_PORT=4004
ADMIN_SERVICE_PORT=4005

# ==========================================
# Microservice Hosts (For Docker Compose network)
# When running inside Docker, use service names.
# When running locally with nodemon, leave as localhost.
# ==========================================
AUTH_SERVICE_HOST=auth-service
USER_SERVICE_HOST=user-service
JOB_SERVICE_HOST=job-service
APPLICATION_SERVICE_HOST=application-service
ADMIN_SERVICE_HOST=admin-service

# ==========================================
# Security & JWT Secrets
# ==========================================
JWT_SECRET=super_secret_production_jwt_key_replace_me
JWT_ACCESS_SECRET=access_token_secret_replace_me
JWT_REFRESH_SECRET=refresh_token_secret_replace_me

# ==========================================
# Domain / Origin Configuration
# In Production with Nginx, use your EC2 Elastic IP or domain name
# ==========================================
FRONTEND_ORIGIN=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/auth/oauth
OAUTH_CLIENT_REDIRECT=http://localhost:3000/oauth/callback

# ==========================================
# OAuth Provider Credentials (Optional)
# ==========================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
