{
  "name": "jobportal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gateway": "nodemon api-gateway/src/server.js",
    "dev:auth": "nodemon services/auth-service/src/server.js",
    "dev:users": "nodemon services/user-service/src/server.js",
    "dev:jobs": "nodemon services/job-service/src/server.js",
    "dev:applications": "nodemon services/application-service/src/server.js",
    "dev:admin": "nodemon services/admin-service/src/server.js",
    "start:gateway": "node api-gateway/src/server.js",
    "start:auth": "node services/auth-service/src/server.js",
    "start:users": "node services/user-service/src/server.js",
    "start:jobs": "node services/job-service/src/server.js",
    "start:applications": "node services/application-service/src/server.js",
    "start:admin": "node services/admin-service/src/server.js",
    "lint:loc": "node scripts/check-loc.js",
    "prisma:generate": "prisma generate --schema=services/auth-service/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=services/auth-service/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=services/auth-service/prisma/schema.prisma",
    "prisma:seed": "node services/auth-service/prisma/seed.js",
    "db:seed": "node services/auth-service/prisma/seed.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "morgan": "^1.10.0",
    "zod": "^4.1.12"
  }
}
